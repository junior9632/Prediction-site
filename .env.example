# =====================================================================
# FOOTBALL PREDICTIONS — environment template
# Copy to .env and fill in. NEVER commit .env. NEVER expose any of these
# values to the browser: the API key lives on the Node.js server only.
# =====================================================================

# ---- Runtime -------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Public origin of the site (used for CORS + secure cookie decisions)
APP_URL=https://yourdomain.com
# cPanel puts the app behind a proxy: set to 1 to trust X-Forwarded-*
TRUST_PROXY=1

# ---- MySQL / MariaDB (cPanel "MySQL Databases") --------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=yourdb_user
DB_PASSWORD=your-strong-password
DB_NAME=yourdb_predictions
DB_CONNECTION_LIMIT=8

# ---- API-Football PRO (server side only) ---------------------------
# Get the key at https://dashboard.api-football.com
API_FOOTBALL_KEY=YOUR_API_KEY
# Default host. RapidAPI users set: api-football-v1.p.rapidapi.com/v3
API_FOOTBALL_HOST=v3.football.api-sports.io
# Requests per minute budget (Pro plans allow ~300 req/min); be conservative
API_FOOTBALL_RATE_PER_MINUTE=60
API_FOOTBALL_TIMEOUT_MS=15000
API_FOOTBALL_MAX_RETRIES=2

# ---- Admin-managed API credentials (API Management screen) ---------
# Master key for AES-256-GCM encryption of API credentials AT REST. Required
# before an administrator can save a key from the dashboard (Admin -> API
# Management). It is NEVER stored in the database: lose it and the stored
# credential must be re-entered. 64 hex chars = 32 bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_CREDENTIALS_ENCRYPTION_KEY=
# OPTIONAL: when the variable above is empty the server creates its own random
# key file (default storage/api-credentials.key, mode 0600) on the first save
# from Admin -> API Management, so no environment change is needed. Back that
# file up with the database; set AUTO_KEY=0 to require the env variable instead.
# API_CREDENTIALS_KEY_FILE=
# API_CREDENTIALS_AUTO_KEY=1
# Bound for the single request the "Test Connection" button performs
API_CREDENTIALS_TEST_TIMEOUT_MS=15000
# Hard floor between two credential tests, and the window in which an
# identical repeat test reuses the previous verdict (no extra API call)
API_CREDENTIALS_TEST_MIN_INTERVAL_MS=3000
API_CREDENTIALS_TEST_REUSE_MS=60000

# ---- Auth / sessions ----------------------------------------------
# 64+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=8h
COOKIE_NAME=fp_token
COOKIE_SECURE=1
COOKIE_SAMESITE=strict
BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# First administrator (created by `npm run db:seed`)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeMe-Immediately-123

# ---- HTTP hardening -----------------------------------------------
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=10
ADMIN_RATE_LIMIT_MAX=120
GENERATE_RATE_LIMIT_MAX=10

# ---- Background sync (fixtures / odds / results ONLY) --------------
# The internal scheduler NEVER generates or publishes a ticket.
ENABLE_INTERNAL_SCHEDULER=0
SCHEDULER_FIXTURES_MINUTES=30
SCHEDULER_ODDS_MINUTES=20
SCHEDULER_RESULTS_MINUTES=30

# ---- Odds integrity defaults (DB `settings` overrides these) -------
ODDS_FRESHNESS_MINUTES=90
MIN_TOTAL_ODDS=2.00
MAX_TOTAL_ODDS=4.00
MIN_CONFIDENCE=72
MAX_RISK=35
MIN_DATA_QUALITY=60
MAX_SELECTIONS=6

# ---- Notifications (optional, server side only) --------------------
# Announce published tickets / NO QUALIFYING TICKET days and send
# operational alerts (health check failed, data source down).
# Also announces the user approval workflow: a new registration is waiting
# (USER_REGISTERED) and each admin decision (USER_APPROVED / USER_REJECTED /
# USER_SUSPENDED / USER_REACTIVATED). Leave empty to disable — the approval
# workflow works fully without any notification channel.
# Telegram: create a bot with @BotFather, add it to your channel/group,
# then set both values. Leave empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Generic webhook: receives POST JSON {source,event,message,data,sentAt}
NOTIFY_WEBHOOK_URL=
NOTIFY_TIMEOUT_MS=10000

# ---- Logging -------------------------------------------------------
LOG_LEVEL=info
LOG_FILE=
REQUEST_LOGGING=1
